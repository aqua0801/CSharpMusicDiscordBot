<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer.Core.zh-Hant" Version="3.0.10" />
    <PackageReference Include="NetCord" Version="1.0.0-alpha.485" />
    <PackageReference Include="NetCord.Services" Version="1.0.0-alpha.485" />
    <PackageReference Include="NetMQ" Version="4.0.4.5" />
    <PackageReference Include="Opus" Version="1.0.0" />
    <PackageReference Include="YoutubeDLSharp" Version="1.2.0" />
    <PackageReference Include="YoutubeExplode" Version="6.6.3" />

	 <None Remove="Assets\**\*" />
	 <None Include="Assets\**\*"
		 TargetPath="%(RecursiveDir)%(Filename)%(Extension)"
	     CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
